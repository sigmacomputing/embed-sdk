{
  "name": "@sigmacomputing/test-pack",
  "author": "sigmacomputing",
  "version": "0.2.0",
  "description": "Package to test the imports entrypoints of the node-embed-sdk package.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/sigmacomputing/embed-sdk.git",
    "directory": "packages/node-embed-sdk"
  },
  "homepage": "https://sigmacomputing.com",
  "bugs": {
    "url": "https://github.com/sigmacomputing/embed-sdk/issues"
  },
  "keywords": [
    "embed",
    "sdk",
    "sigma",
    "node"
  ],
  "scripts": {
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@sigmacomputing/node-embed-sdk": "workspace:*",
    "@swc/core": "^1.11.29",
    "@swc/jest": "^0.2.38",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.17.16",
    "jest": "^30.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": [
        "@swc/jest",
        {
          "module": {
            "type": "commonjs"
          },
          "sourceMaps": "inline"
        }
      ]
    },
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**.(i|)(spec|test).(j|t)s(x|)"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/dist/"
    ]
  }
}
